{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "cppbuild",
            "label": "C/C++: clang++.exe build mpi_app",
            "command": "C:\\Program Files (x86)\\Microsoft Visual Studio\\2019\\Community\\VC\\Tools\\Llvm\\x64\\bin\\clang++.exe",
            "args": [
                "-fcolor-diagnostics",
                "-fansi-escape-codes",
                "-g",
                "-std=c++17",
                "-I",
                "C:\\Program Files (x86)\\Microsoft SDKs\\MPI\\Include",
                "${workspaceFolder}\\src\\main.cpp",
                "${workspaceFolder}\\src\\heat_diffusion.cpp",
                "${workspaceFolder}\\src\\prefix_sum.cpp",
                "${workspaceFolder}\\src\\deadlock_demo.cpp",
                "C:\\Program Files (x86)\\Microsoft SDKs\\MPI\\Lib\\x64\\msmpi.lib",
                "-o",
                "${workspaceFolder}\\mpi_app.exe"
